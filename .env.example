# Twilio voice webhook URL configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
GUARD_TWILIO_PHONE_NUMBER=your_guard_query_twilio_phone_number

# OpenAI API key for conversation understanding
OPENAI_API_KEY=your_openai_api_key

# Personal WeChat notification via PushPlus
# 1. Sign in at https://www.pushplus.plus/ with WeChat
# 2. Follow the PushPlus WeChat official account
# 3. Copy your token here
PUSHPLUS_TOKEN=your_pushplus_token

# Optional PushPlus group topic. Leave empty to send only to yourself.
PUSHPLUS_TOPIC=

# Local server settings
PORT=3000
HOST=0.0.0.0

# Public HTTPS base URL for Twilio Media Streams, for example:
# PUBLIC_BASE_URL=https://your-ngrok-domain.ngrok-free.app
PUBLIC_BASE_URL=

# OpenAI Realtime model
OPENAI_REALTIME_MODEL=gpt-realtime

# Optional token for guard query API. If set, call /guard/query with:
# Authorization: Bearer your_guard_query_token
GUARD_QUERY_TOKEN=
